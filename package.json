{
  "name": "murmur-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "pnpm -r --parallel --aggregate-output test",
    "test:ui": "pnpm --filter @murmur/ui test",
    "lint": "oxlint && oxlint --type-aware -c oxlint.type-aware.json && oxfmt --check",
    "lint:fix": "oxfmt && oxlint --fix; oxfmt && oxlint",
    "typecheck": "pnpm -r --parallel --aggregate-output typecheck",
    "build:ui": "pnpm --filter @murmur/ui build",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "example": "pnpm --filter @murmur-examples/todo-api dev",
    "release:snapshot": "node scripts/release/snapshot.ts",
    "release:publish": "node scripts/release/publish.ts",
    "release:verify": "node scripts/release/verify.ts"
  },
  "devDependencies": {
    "@murmur/lint": "workspace:*",
    "@types/node": "26.6.5",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.11.2"
}
