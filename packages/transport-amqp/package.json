{
  "name": "@murmur/transport-amqp",
  "version": "0.3.0",
  "license": "MIT",
  "files": [
    "src",
    "!src/**/*.test.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./src/index.ts",
        "default": "./src/index.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "prepack": "node ../../scripts/release/emit.ts",
    "postpack": "node ../../scripts/release/emit.ts --clean",
    "test": "node --test 'src/**/*.test.ts' 'test/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "amqplib": "2.2.0",
    "murmur": "workspace:*"
  },
  "devDependencies": {
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=26"
  }
}
