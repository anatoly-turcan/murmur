{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript"],
  "categories": {
    "correctness": "off",
    "suspicious": "off",
    "perf": "off"
  },
  "ignorePatterns": ["**/node_modules/**", "**/dist/**", "**/.murmur/**", "**/coverage/**"],
  "rules": {
    "typescript/switch-exhaustiveness-check": ["error", { "considerDefaultExhaustiveForUnions": true }]
  }
}
